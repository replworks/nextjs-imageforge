{
  "name": "@replworks/nextjs-imageforge",
  "version": "0.0.0",
  "description": "A Next.js client for the Image Forge service.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/replworks/nextjs-imageforge.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0"
  },
  "peerDependencies": {
    "next": "^16.0.0"
  },
  "devDependencies": {
    "next": "^16.0.0",
    "prettier": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
